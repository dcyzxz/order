.action-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}
.add-btn { background: #07c160; color: #fff; border: none; border-radius: 8rpx; padding: 12rpx 24rpx; font-size: 26rpx; }
.group { margin: 20rpx 30rpx; }
.group-title { font-size: 28rpx; font-weight: 600; color: #333; display: block; margin-bottom: 12rpx; padding-left: 10rpx; border-left: 4rpx solid #07c160; }
.material-item { display: flex; align-items: center; margin: 0; margin-bottom: 12rpx; }
.material-info { flex: 1; }
.material-name { font-size: 28rpx; display: block; }
.material-desc { font-size: 22rpx; color: #999; display: block; }
.allergen-tag { font-size: 18rpx; color: #f56c6c; background: #fef0f0; padding: 2rpx 8rpx; border-radius: 4rpx; margin-right: 16rpx; }
.edit-btn { font-size: 22rpx; padding: 8rpx 20rpx; background: #ecf5ff; color: #409eff; border: none; border-radius: 6rpx; }

.modal-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); display:flex; justify-content:center; align-items:center; z-index:1000; }
.modal-dialog { background:#fff; border-radius:16rpx; padding:40rpx; width:600rpx; }
.modal-title { font-size:32rpx; font-weight:600; display:block; text-align:center; margin-bottom:30rpx; }
.modal-input, .modal-textarea { border:1rpx solid #ddd; border-radius:8rpx; padding:16rpx; font-size:28rpx; margin-bottom:20rpx; width:100%; box-sizing:border-box; }
.modal-textarea { min-height:100rpx; }
.modal-checkbox { display:flex; align-items:center; gap:10rpx; margin-bottom:20rpx; font-size:26rpx; }
.modal-actions { display:flex; justify-content:space-around; margin-top:30rpx; }
.btn-cancel { background:#f5f5f5; color:#666; border:none; border-radius:44rpx; padding:16rpx 60rpx; }
.btn-submit { background:#07c160; color:#fff; border:none; border-radius:44rpx; padding:16rpx 60rpx; }
