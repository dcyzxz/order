.admin-header {
  background: linear-gradient(135deg, #07c160, #06ad56);
  padding: 60rpx 40rpx;
  color: #fff;
}

.admin-title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.admin-subtitle {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 10rpx;
  display: block;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 30rpx;
}

.menu-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  width: calc(50% - 10rpx);
  box-sizing: border-box;
}

.menu-icon { font-size: 60rpx; margin-bottom: 12rpx; }
.menu-label { font-size: 28rpx; font-weight: 600; }
.menu-desc { font-size: 22rpx; color: #999; margin-top: 8rpx; }

.stats-section { margin: 0 30rpx; }
.stats-title { font-size: 30rpx; font-weight: 600; display: block; margin-bottom: 20rpx; }

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-value { font-size: 48rpx; font-weight: 700; color: #07c160; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }
