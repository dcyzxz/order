.filter-bar {
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  overflow-x: auto;
  white-space: nowrap;
  gap: 10rpx;
}

.filter-tab {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.filter-tab.active { background: #f0f9eb; color: #07c160; }

.order-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.order-no { font-size: 24rpx; color: #999; }
.order-status { font-size: 22rpx; padding: 2rpx 10rpx; border-radius: 4rpx; }
.status-pending { background: #fdf6ec; color: #e6a23c; }
.status-confirmed { background: #f0f9eb; color: #67c23a; }
.status-preparing { background: #ecf5ff; color: #409eff; }
.status-completed { background: #f5f5f5; color: #999; }
.status-cancelled { background: #fef0f0; color: #f56c6c; }
.order-body { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.order-user { font-size: 24rpx; color: #666; }
.order-total { font-size: 28rpx; color: #f56c6c; font-weight: 600; }
.order-items { margin-bottom: 8rpx; }
.order-item-row { font-size: 24rpx; color: #333; padding: 4rpx 0; }
.order-footer { display: flex; justify-content: space-between; align-items: center; }
.order-time { font-size: 22rpx; color: #ccc; }
.order-actions { display: flex; gap: 10rpx; }
.action-btn { background: #07c160; color: #fff; border: none; border-radius: 6rpx; padding: 8rpx 20rpx; font-size: 22rpx; }
.action-btn.cancel { background: #f5f5f5; color: #666; }
.action-btn.complete { background: #409eff; }
