.action-bar {
  padding: 20rpx 30rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.add-btn { background: #07c160; color: #fff; border: none; border-radius: 8rpx; padding: 12rpx 24rpx; font-size: 26rpx; }
.filter-tabs { display: flex; gap: 10rpx; flex-wrap: wrap; }
.filter-tab { padding: 8rpx 16rpx; font-size: 24rpx; color: #666; border-radius: 6rpx; }
.filter-tab.active { background: #f0f9eb; color: #07c160; }
.dish-item { display: flex; justify-content: space-between; align-items: center; }
.dish-header { display: flex; align-items: center; gap: 12rpx; }
.dish-name { font-size: 28rpx; font-weight: 500; }
.dish-status { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 4rpx; }
.status-active { background: #f0f9eb; color: #67c23a; }
.status-inactive { background: #f5f5f5; color: #999; }
.status-pending_price { background: #fdf6ec; color: #e6a23c; }
.dish-price { font-size: 26rpx; color: #f56c6c; display: block; }
.dish-category { font-size: 22rpx; color: #999; display: block; }
.dish-actions { display: flex; gap: 10rpx; }
.action-btn { font-size: 22rpx; padding: 8rpx 16rpx; border: none; border-radius: 6rpx; }
.edit { background: #ecf5ff; color: #409eff; }
.offline { background: #fef0f0; color: #f56c6c; }
.online { background: #f0f9eb; color: #67c23a; }

.modal-mask { position: fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); display:flex; justify-content:center; align-items:center; z-index:1000; }
.modal-dialog { background:#fff; border-radius:16rpx; padding:40rpx; width:600rpx; }
.modal-title { font-size:32rpx; font-weight:600; display:block; text-align:center; margin-bottom:30rpx; }
.modal-input, .modal-textarea, .modal-picker { border:1rpx solid #ddd; border-radius:8rpx; padding:16rpx; font-size:28rpx; margin-bottom:20rpx; width:100%; box-sizing:border-box; }
.modal-textarea { min-height:100rpx; }
.modal-picker { background:#f9f9f9; }
.modal-actions { display:flex; justify-content:space-around; margin-top:30rpx; }
.btn-cancel { background:#f5f5f5; color:#666; border:none; border-radius:44rpx; padding:16rpx 60rpx; }
.btn-submit { background:#07c160; color:#fff; border:none; border-radius:44rpx; padding:16rpx 60rpx; }
