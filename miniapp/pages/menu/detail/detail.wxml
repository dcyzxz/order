<view class="container">
  <!-- 菜品信息 -->
  <view class="dish-header card">
    <image class="dish-image" src="{{dish.imageUrl || '/images/dish-placeholder.png'}}" mode="aspectFill" />
    <text class="dish-name">{{dish.name}}</text>
    <text class="dish-price" wx:if="{{dish.price}}">¥{{dish.price}}</text>
    <text class="dish-desc" wx:if="{{dish.description}}">{{dish.description}}</text>
    <view class="dish-tags">
      <text class="tag" wx:if="{{dish.isRecommended}}">推荐</text>
      <text class="tag" wx:if="{{dish.status === 'active'}}">在售</text>
    </view>
  </view>

  <!-- 材料清单 -->
  <view class="section card">
    <view class="section-header">
      <text class="section-title">📋 材料清单</text>
      <text class="section-hint">(勾选可排除)</text>
    </view>
    <view class="material-list">
      <label
        class="material-item"
        wx:for="{{dish.materials}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="toggleMaterial"
      >
        <checkbox checked="{{selectedMaterials.indexOf(item.id) > -1}}" />
        <text class="material-name {{item.isAllergen ? 'allergen' : ''}}">{{item.name}}</text>
        <text class="material-category" wx:if="{{item.category}}">{{item.category}}</text>
        <text class="allergen-tag" wx:if="{{item.isAllergen}}">过敏原</text>
      </label>
    </view>
    <view class="selected-info" wx:if="{{selectedMaterials.length > 0}}">
      <text class="info-text">已排除 {{selectedMaterials.length}} 种材料</text>
    </view>
  </view>

  <!-- 数量选择 -->
  <view class="section card">
    <view class="quantity-section">
      <text class="quantity-label">数量</text>
      <view class="quantity-controls">
        <button class="qty-btn" bindtap="decrement" disabled="{{quantity <= 1}}">−</button>
        <text class="qty-value">{{quantity}}</text>
        <button class="qty-btn" bindtap="increment">+</button>
      </view>
    </view>
  </view>

  <!-- 底部固定栏 -->
  <view class="fixed-bottom">
    <view class="total-info">
      <text class="total-price">{{totalPrice}}</text>
    </view>
    <button class="add-cart-btn" bindtap="addToCart">加入购物车</button>
  </view>
</view>
