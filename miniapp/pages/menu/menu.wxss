.container {
  min-height: 100vh;
}

.category-bar {
  background: #fff;
  white-space: nowrap;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
}

.category-tab {
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  flex-shrink: 0;
}

.category-tab.active {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
}

.search-btn {
  color: #07c160;
  font-size: 28rpx;
  margin-left: 20rpx;
}

.dish-list {
  padding: 0 30rpx 120rpx;
}

.dish-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.dish-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.dish-content {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
}

.dish-category {
  font-size: 22rpx;
  color: #999;
}

.dish-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-price {
  font-size: 32rpx;
  color: #f56c6c;
  font-weight: 600;
}

.dish-sales {
  font-size: 22rpx;
  color: #999;
}

.dish-tags {
  display: flex;
  gap: 8rpx;
}

.add-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 48rpx;
  height: 48rpx;
  background: #07c160;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 48rpx;
  text-align: center;
}
