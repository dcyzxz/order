.container {
  padding-bottom: 120rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item:last-child { border-bottom: none; }

.item-info { flex: 1; }
.item-name { font-size: 28rpx; display: block; }
.item-excluded { font-size: 22rpx; color: #999; }
.item-qty { font-size: 26rpx; color: #666; margin: 0 20rpx; }
.item-price { font-size: 28rpx; color: #f56c6c; min-width: 100rpx; text-align: right; }

.note-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.total-section { display: flex; align-items: baseline; }
.total-label { font-size: 28rpx; }
.total-price { font-size: 40rpx; color: #f56c6c; font-weight: 600; }

.submit-btn {
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
  font-weight: 500;
}
