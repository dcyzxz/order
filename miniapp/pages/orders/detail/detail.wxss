.container {
  padding-bottom: 120rpx;
}

.status-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-badge {
  font-size: 36rpx;
  font-weight: 600;
  padding: 8rpx 32rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.status-pending { background: #fdf6ec; color: #e6a23c; }
.status-confirmed { background: #f0f9eb; color: #67c23a; }
.status-preparing { background: #ecf5ff; color: #409eff; }
.status-completed { background: #f5f5f5; color: #999; }
.status-cancelled { background: #fef0f0; color: #f56c6c; }

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-time {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  display: block;
}

.item-excluded {
  font-size: 22rpx;
  color: #999;
}

.item-qty {
  font-size: 26rpx;
  color: #666;
  margin: 0 20rpx;
}

.item-price {
  font-size: 28rpx;
  color: #f56c6c;
  min-width: 100rpx;
  text-align: right;
}

.note-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.total-section {
  display: flex;
  align-items: baseline;
}

.total-label { font-size: 28rpx; }
.total-price { font-size: 36rpx; color: #f56c6c; font-weight: 600; }

.cancel-btn {
  background: #fef0f0;
  color: #f56c6c;
  border: none;
  border-radius: 44rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
}
