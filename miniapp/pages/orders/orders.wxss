.status-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  flex-shrink: 0;
}

.status-tab.active {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}

.order-list {
  padding-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.status-pending { background: #fdf6ec; color: #e6a23c; }
.status-confirmed { background: #f0f9eb; color: #67c23a; }
.status-preparing { background: #ecf5ff; color: #409eff; }
.status-completed { background: #f5f5f5; color: #999; }
.status-cancelled { background: #fef0f0; color: #f56c6c; }

.order-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-count {
  font-size: 28rpx;
  color: #333;
}

.order-total {
  font-size: 32rpx;
  color: #f56c6c;
  font-weight: 600;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
}

.order-time {
  font-size: 22rpx;
  color: #ccc;
}
