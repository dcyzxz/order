# Railway 部署时这些在 dashboard 中设置，无需本地 .env 文件

# Server
PORT=8000
APP_NAME=点菜小程序
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1

# Database (Railway → MySQL Plugin)
DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/order_miniapp?charset=utf8mb4
DATABASE_URL_SYNC=mysql+pymysql://root:password@localhost:3306/order_miniapp?charset=utf8mb4

# Redis (可选)
REDIS_URL=redis://localhost:6379/0

# JWT (生产环境务必修改)
JWT_SECRET_KEY=change-this-to-a-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
